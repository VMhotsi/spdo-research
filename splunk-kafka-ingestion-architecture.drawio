        <mxCell id="ctlEdgeOtel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#999999;" edge="1" parent="1" source="ctlOtel" target="otel">
