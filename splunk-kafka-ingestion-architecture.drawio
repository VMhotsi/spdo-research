        <mxCell id="ctlCM" value="Cluster Manager&#10;Indexer-cluster bundle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1070" y="800" width="205" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ctlSH" value="Search Head / SHC&#10;Search-time config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="800" width="205" height="70" as="geometry" />
