  <diagram id="kafka-splunk-ingest" name="Kafka to Splunk Enterprise">
    <mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Kafka ingestion on Splunk Enterprise 10.x&#10;SOC4Kafka ingestion → HF parsing/routing → EP transforms → indexer cluster → search-time fields" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="120" y="25" width="1360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="kafka" value="Kafka cluster&#10;Topics / partitions&#10;Source-side access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#4A86B8;fontStyle=1;;;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="190" width="190" height="130" as="geometry" />
        </mxCell>
        <mxCell id="otel" value="Splunk OTel Collector&#10;for Kafka (SOC4Kafka)&#10;Kafka receiver&#10;HEC exporter only&#10;(no transformations)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#4472C4;fontStyle=1;;;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="180" width="235" height="150" as="geometry" />
        </mxCell>
        <mxCell id="hf" value="Heavy Forwarder (HF)&#10;HEC input&#10;Event breaking + parsing&#10;Timestamp / metadata&#10;Routing and S2S target group to EP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;;align=left;verticalAlign=middle;spacingLeft=78;spacingRight=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="660" y="155" width="275" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ep" value="Edge Processor (EP)&#10;S2S input from HF&#10;SPL2 pipeline&#10;Additional field extraction&#10;Filter / drop / mask / transform&#10;Does not re-break HF-framed events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;fontStyle=1;;;align=left;verticalAlign=middle;spacingLeft=66;spacingRight=8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1020" y="145" width="285" height="220" as="geometry" />
        </mxCell>
        <mxCell id="indexers" value="Indexer cluster&#10;Indexing tier&#10;Cluster-managed indexes/config&#10;Avoid unintended repeated transforms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#8064A2;fontStyle=1;;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1390" y="170" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="sh" value="Search Head&#10;Search-time extractions&#10;Search knowledge objects" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#C55A11;fontStyle=1;;align=left;verticalAlign=middle;spacingLeft=60;spacingRight=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1390" y="440" width="220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="edge1" value="Kafka topic consumption" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="kafka" target="otel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2" value="HEC / HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="otel" target="hf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge3" value="Splunk-to-Splunk; HF target group" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="hf" target="ep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge4" value="Splunk Enterprise output&#10;(confirm configured protocol)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="ep" target="indexers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge5" value="Indexed data / search" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="indexers" target="sh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="Event-breaking boundary&#10;In the HF → EP flow, Splunk documents the HF breaking events using props.conf. EP applies additional pipeline transforms. EP event breaking is source-type / input dependent (for example, raw HEC); the HEC event endpoint treats each top-level JSON object as an event." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="625" y="405" width="680" height="125" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="Indexer protocol caveat&#10;Post-EP processing depends on destination. HEC can cause platform props.conf / transforms.conf processing; S2S behavior differs. Confirm output mode and avoid duplicate transformations on peers." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#F4CCCC;strokeColor=#CC0000;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1015" y="595" width="595" height="110" as="geometry" />
        </mxCell>
        <mxCell id="controlTitle" value="Configuration / management planes (not additional data-processing hops)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#404040;" vertex="1" parent="1">
          <mxGeometry x="70" y="745" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ctlKafka" value="Kafka admin&#10;Topics / ACLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="800" width="175" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ctlOtel" value="Collector deployment&#10;Config / secrets / replicas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="800" width="205" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ctlHF" value="HF config distribution&#10;Deployment Server if used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="800" width="205" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ctlEP" value="EP service / control plane&#10;Pipelines / source / destination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="800" width="235" height="70" as="geometry" />
